# Environment Configuration
# Copy this file to .env and fill in your values

SECRET_KEY=your-super-secret-key-change-this-in-production

# MySQL / TiDB Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ai_career_platform
DB_SSL_CA=

# Cloudinary Storage Configuration (Required for Vercel persistent storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Hugging Face / Qwen AI Configuration
HF_TOKEN=hf_your_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_PROVIDER=hf-inference
QWEN_TOKEN=hf_your_token_here
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
QWEN_PROVIDER=auto
QWEN_TIMEOUT=90

# Upload Configuration
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=uploads

# Flask & Deployment Environment
FLASK_CONFIG=development
FLASK_ENV=development
FLASK_DEBUG=True
VERCEL=
